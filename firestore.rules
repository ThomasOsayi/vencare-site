rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admins are listed as docs at admins/{lowercased email}. Manage them in the console or with scripts/add-admin.mjs.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    match /admins/{email} {
      // A signed-in user may only check their own admin doc. Nobody writes from the client.
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    match /submissions/{id} {
      allow read: if isAdmin();
      // Admins may only change status, notes and updatedAt.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
        && request.resource.data.status in ['new', 'contacted', 'in_conversation', 'pilot', 'closed']
        && request.resource.data.notes is list;
      // The website form creates submissions through the web SDK, so only a well-formed new submission is allowed.
      allow create: if request.resource.data.keys().hasOnly(['audience', 'name', 'email', 'org', 'answers', 'status', 'notes', 'source', 'createdAt', 'userAgent'])
        && request.resource.data.audience in ['organization', 'individual', 'insurer']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && request.resource.data.email.size() <= 200
        && request.resource.data.org is string && request.resource.data.org.size() <= 200
        && request.resource.data.answers is map && request.resource.data.answers.size() <= 30
        && request.resource.data.status == 'new'
        && request.resource.data.notes == []
        && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300;
      allow delete: if false;
    }
  }
}

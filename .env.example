# --- Firebase web config (Firebase console > Project settings > Your apps > Web app) ---
# Public by design; access is enforced by Firestore rules + the admins allowlist.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only: Project settings > Service accounts > Generate new private key) ---
# Used by /api/interest to save form submissions. Paste the private key with literal \n line breaks.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Optional: also forward each submission to a webhook (e.g. the survey spreadsheet) ---
FORM_WEBHOOK_URL=
